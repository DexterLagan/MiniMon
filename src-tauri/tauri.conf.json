{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniMon",
  "version": "0.1.0",
  "identifier": "dev.minimon.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MiniMon",
        "width": 560,
        "height": 480,
        "minWidth": 420,
        "minHeight": 360,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0e16"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
